#helpers 

def parse_fasta(fasta_path: Path):
    sequences = {}
    seq_id = None
    chunks = []

    with fasta_path.open("r", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue

            if line.startswith(">"):
                if seq_id is not None:
                    sequences[seq_id] = "".join(chunks).upper()
                seq_id = line[1:].split()[0]
                chunks = []
            else:
                chunks.append(line)

    if seq_id is not None:
        sequences[seq_id] = "".join(chunks).upper()

    return sequences


def reverse_complement(seq: str):
    return seq.translate(COMPLEMENT)[::-1]


def parse_gff_cds(gff_path: Path):
    cds_by_transcript = defaultdict(list)

    with gff_path.open("r", encoding="utf-8") as handle:
        for line in handle:
            if not line or line.startswith("#"):
                continue

            fields = line.rstrip("\n").split("\t")
            if len(fields) != 9:
                continue

            seqid, source, feature, start, end, score, strand, phase, attributes = fields

            if feature != "CDS":
                continue

            attr_map = {}
            for item in attributes.split(";"):
                if "=" in item:
                    k, v = item.split("=", 1)
                    attr_map[k] = v

            transcript_id = (
                attr_map.get("Parent")
                or attr_map.get("transcript_id")
                or attr_map.get("ID")
            )

            if transcript_id is None:
                continue

            cds_by_transcript[transcript_id].append({
                "seqid": seqid,
                "start": int(start),
                "end": int(end),
                "strand": strand,
                "phase": phase,
            })

    return cds_by_transcript


def build_cds_sequences(genome, cds_by_transcript):
    transcript_sequences = {}

    for transcript_id, blocks in cds_by_transcript.items():
        strand = blocks[0]["strand"]
        seqid = blocks[0]["seqid"]

        if seqid not in genome:
            continue

        chrom_seq = genome[seqid]

        if strand == "+":
            blocks_sorted = sorted(blocks, key=lambda x: x["start"])
            seq = "".join(chrom_seq[b["start"] - 1:b["end"]] for b in blocks_sorted)
        else:
            blocks_sorted = sorted(blocks, key=lambda x: x["start"], reverse=True)
            seq = "".join(
                reverse_complement(chrom_seq[b["start"] - 1:b["end"]])
                for b in blocks_sorted
            )

        seq = seq.upper()
        usable_len = len(seq) - (len(seq) % 3)

        if usable_len >= 3:
            transcript_sequences[transcript_id] = seq[:usable_len]

    return transcript_sequences


#opportunity calculations

def count_opportunities_in_cds(cds_seq: str):
    syn_opp = 0
    nonsyn_opp = 0

    for i in range(0, len(cds_seq), 3):
        codon = cds_seq[i:i + 3]

        if len(codon) != 3:
            continue

        if set(codon) - VALID_BASES:
            continue

        if codon not in CODON_TABLE:
            continue

        aa_ref = CODON_TABLE[codon]

        for pos in range(3):
            ref_base = codon[pos]

            for alt_base in VALID_BASES:
                if alt_base == ref_base:
                    continue

                alt_codon = list(codon)
                alt_codon[pos] = alt_base
                alt_codon = "".join(alt_codon)

                if alt_codon not in CODON_TABLE:
                    continue

                aa_alt = CODON_TABLE[alt_codon]

                if aa_alt == aa_ref:
                    syn_opp += 1
                else:
                    nonsyn_opp += 1

    return syn_opp, nonsyn_opp


def compute_species_opportunities(species_name: str):
    species_dir = RESOURCE_BASE_DIR / species_name
    fasta_path = species_dir / "sequences.fa"
    gff_path = species_dir / "genes.gff"

    if not fasta_path.exists():
        raise FileNotFoundError(f"Missing FASTA for {species_name}: {fasta_path}")

    if not gff_path.exists():
        raise FileNotFoundError(f"Missing GFF for {species_name}: {gff_path}")

    genome = parse_fasta(fasta_path)
    cds_by_transcript = parse_gff_cds(gff_path)
    transcript_sequences = build_cds_sequences(genome, cds_by_transcript)

    total_syn_opp = 0
    total_nonsyn_opp = 0

    for cds_seq in transcript_sequences.values():
        syn_opp, nonsyn_opp = count_opportunities_in_cds(cds_seq)
        total_syn_opp += syn_opp
        total_nonsyn_opp += nonsyn_opp

    return total_syn_opp, total_nonsyn_opp


#VCF Classification

def extract_ann_field(info_field: str):
    for item in info_field.split(";"):
        if item.startswith("ANN="):
            value = item[4:]
            return value.split(",") if value else []
    return []


def classify_annotation_effect(effect_string: str):
    effects = set(effect_string.split("&"))

    if effects & NONSYNONYMOUS_TERMS:
        return "nonsynonymous"

    if effects & SYNONYMOUS_TERMS:
        return "synonymous"

    return None


def classify_variant_from_ann_entries(ann_entries):
    site_classes = []

    for ann in ann_entries:
        parts = ann.split("|")

        if len(parts) < 2:
            continue

        classification = classify_annotation_effect(parts[1].strip())

        if classification:
            site_classes.append(classification)

    if not site_classes:
        return None

    if COUNT_PER_SITE:
        if "nonsynonymous" in site_classes:
            return "nonsynonymous"
        if "synonymous" in site_classes:
            return "synonymous"
        return None

    return site_classes


def parse_annotated_vcf(vcf_path: Path):
    counts = defaultdict(int)

    with vcf_path.open("r", encoding="utf-8") as handle:
        for line in handle:
            if not line or line.startswith("#"):
                continue

            fields = line.rstrip("\n").split("\t")

            if len(fields) < 8:
                continue

            ann_entries = extract_ann_field(fields[7])

            if not ann_entries:
                continue

            classification = classify_variant_from_ann_entries(ann_entries)

            if classification is None:
                continue

            if COUNT_PER_SITE:
                counts[classification] += 1
            else:
                for c in classification:
                    counts[c] += 1

    return counts


def find_species_vcfs(base_dir: Path):
    species_vcfs = []

    if not base_dir.exists():
        raise FileNotFoundError(f"Base directory not found: {base_dir}")

    for species_dir in sorted(base_dir.iterdir()):
        if species_dir.name.startswith("."):
            continue

        if not species_dir.is_dir():
            continue

        species_name = species_dir.name
        expected_vcf = species_dir / f"{species_name}.ann.vcf"

        if expected_vcf.exists():
            species_vcfs.append((species_name, expected_vcf))
        else:
            print(f"Warning: expected file not found for {species_name}: {expected_vcf}")

    return species_vcfs


#colour helpers

def adjust_color(color, factor=1.0):
    rgb = np.array(mcolors.to_rgb(color))

    if factor < 1:
        return tuple(np.clip(rgb * factor, 0, 1))

    return tuple(np.clip(rgb + (1 - rgb) * (factor - 1), 0, 1))


def build_species_colors(species_names):
    genus_to_species = defaultdict(list)

    for sp in species_names:
        genus = GENUS_MAP.get(sp, "Unknown")
        genus_to_species[genus].append(sp)

    species_colors = {}

    for genus, members in genus_to_species.items():
        members = sorted(members)
        cmap = plt.get_cmap(GENUS_COLORMAPS.get(genus, "tab20"))

        if len(members) == 1:
            shade_positions = [0.65]
        else:
            shade_positions = np.linspace(0.45, 0.8, len(members))

        for sp, pos in zip(members, shade_positions):
            base_color = cmap(pos)

            species_colors[sp] = {
                "base": base_color,
                "synonymous": adjust_color(base_color, factor=0.75),
                "nonsynonymous": adjust_color(base_color, factor=1.25),
            }

    return species_colors


def order_species_by_genus(species_names):
    genus_to_species = defaultdict(list)

    for sp in species_names:
        genus = GENUS_MAP.get(sp, "Unknown")
        genus_to_species[genus].append(sp)

    ordered_genera = sorted(genus_to_species.keys())

    ordered_species = []
    for genus in ordered_genera:
        ordered_species.extend(sorted(genus_to_species[genus]))

    return ordered_species, ordered_genera, genus_to_species


def compute_cluster_positions(
    ordered_genera,
    genus_to_species,
    bar_width=0.8,
    intra_gap=0.15,
    inter_gap=1.2,
):
    positions = {}
    x = 0.0

    for genus in ordered_genera:
        members = sorted(genus_to_species[genus])

        for sp in members:
            positions[sp] = x
            x += bar_width + intra_gap

        x += inter_gap

    return positions


def add_genus_separators(ax, ordered_genera, genus_to_species, positions):
    for i in range(len(ordered_genera) - 1):
        current_genus = ordered_genera[i]
        next_genus = ordered_genera[i + 1]

        current_members = sorted(genus_to_species[current_genus])
        next_members = sorted(genus_to_species[next_genus])

        right_edge = positions[current_members[-1]] + 0.4
        left_edge = positions[next_members[0]] - 0.4
        sep_x = (right_edge + left_edge) / 2

        ax.axvline(
            sep_x,
            color="lightgray",
            linestyle="--",
            linewidth=0.8,
            zorder=0,
        )


def build_legend_handles(ordered_genera, genus_to_species, species_colors):
    handles = [
        mpatches.Patch(facecolor="dimgray", edgecolor="black", label="Synonymous"),
        mpatches.Patch(facecolor="lightgray", edgecolor="black", label="Non-synonymous"),
    ]

    for genus in ordered_genera:
        for sp in sorted(genus_to_species[genus]):
            handles.append(
                mpatches.Patch(
                    facecolor=species_colors[sp]["base"],
                    edgecolor="black",
                    label=f"{genus} — {SPECIES_LABELS.get(sp, sp)}",
                )
            )

    return handles


#main
def main():
    species_vcfs = find_species_vcfs(VCF_BASE_DIR)

    if not species_vcfs:
        raise FileNotFoundError(f"No annotated VCF files found under {VCF_BASE_DIR}")

    raw_results = {}

    for species_name, vcf_path in species_vcfs:
        counts = parse_annotated_vcf(vcf_path)

        syn_obs = counts["synonymous"]
        nonsyn_obs = counts["nonsynonymous"]
        total_obs = syn_obs + nonsyn_obs

        syn_opp, nonsyn_opp = compute_species_opportunities(species_name)

        if syn_obs == 0 or syn_opp == 0 or nonsyn_opp == 0:
            normalized_ratio = np.nan
        else:
            dn = nonsyn_obs / nonsyn_opp
            ds = syn_obs / syn_opp
            normalized_ratio = np.nan if ds == 0 else dn / ds

        if total_obs == 0:
            syn_prop = 0.0
            nonsyn_prop = 0.0
        else:
            syn_prop = syn_obs / total_obs
            nonsyn_prop = nonsyn_obs / total_obs

        raw_results[species_name] = {
            "synonymous_count": syn_obs,
            "nonsynonymous_count": nonsyn_obs,
            "total_count": total_obs,
            "synonymous_opportunity": syn_opp,
            "nonsynonymous_opportunity": nonsyn_opp,
            "synonymous_prop": syn_prop,
            "nonsynonymous_prop": nonsyn_prop,
            "normalized_ratio": normalized_ratio,
            "label": SPECIES_LABELS.get(species_name, species_name),
            "genus": GENUS_MAP.get(species_name, "Unknown"),
        }

        print(
            f"{SPECIES_LABELS.get(species_name, species_name)}: "
            f"S_obs={syn_obs}, "
            f"N_obs={nonsyn_obs}, "
            f"S_opp={syn_opp}, "
            f"N_opp={nonsyn_opp}, "
            f"S_prop={syn_prop:.4f}, "
            f"N_prop={nonsyn_prop:.4f}, "
            f"normalized_dN/dS={normalized_ratio}"
        )

    species_names = list(raw_results.keys())

    ordered_species, ordered_genera, genus_to_species = order_species_by_genus(species_names)
    positions = compute_cluster_positions(ordered_genera, genus_to_species)
    species_colors = build_species_colors(ordered_species)
    legend_handles = build_legend_handles(ordered_genera, genus_to_species, species_colors)

    xticks = [positions[sp] for sp in ordered_species]
    xticklabels = [raw_results[sp]["label"] for sp in ordered_species]

    fig, (ax_top, ax_bottom) = plt.subplots(
        2,
        1,
        figsize=(18, 14),
        sharex=False,
    )

#top graph, proportions

    for sp in ordered_species:
        x = positions[sp]
        syn_prop = raw_results[sp]["synonymous_prop"]
        nonsyn_prop = raw_results[sp]["nonsynonymous_prop"]

        ax_top.bar(
            x,
            syn_prop,
            width=0.8,
            color=species_colors[sp]["synonymous"],
            edgecolor="black",
            linewidth=0.4,
        )

        ax_top.bar(
            x,
            nonsyn_prop,
            bottom=syn_prop,
            width=0.8,
            color=species_colors[sp]["nonsynonymous"],
            edgecolor="black",
            linewidth=0.4,
        )

    add_genus_separators(ax_top, ordered_genera, genus_to_species, positions)

    ax_top.set_ylabel("Proportion")
    ax_top.set_xlabel("Species")
    ax_top.set_ylim(0, 1)
    ax_top.set_xticks(xticks)
    ax_top.set_xticklabels(xticklabels, rotation=60, ha="right")
    ax_top.set_title(
        "Proportion of Synonymous vs Non-synonymous Mutations",
        pad=20,
    )

   #bottom is opportunity normalised dN/dS
   
    for sp in ordered_species:
        ax_bottom.bar(
            positions[sp],
            raw_results[sp]["normalized_ratio"],
            width=0.8,
            color=species_colors[sp]["base"],
            edgecolor="black",
            linewidth=0.5,
        )

    add_genus_separators(ax_bottom, ordered_genera, genus_to_species, positions)

    ax_bottom.axhline(
        1.0,
        color="gray",
        linestyle="--",
        linewidth=1.0,
    )

    ax_bottom.set_ylabel("Opportunity-normalized dN/dS")
    ax_bottom.set_xlabel("Species")
    ax_bottom.set_xticks(xticks)
    ax_bottom.set_xticklabels(xticklabels, rotation=60, ha="right")
    ax_bottom.set_title(
        "Non-synonymous : Synonymous Ratio (dN/dS) — Opportunity Normalised",
        pad=20,
    )

#one shared legend at bottom of plots

    fig.legend(
        handles=legend_handles,
        title="Legend",
        loc="lower center",
        bbox_to_anchor=(0.5, -0.02),
        ncol=4,
        frameon=True,
        fontsize=9,
        title_fontsize=10,
        handlelength=1.4,
        columnspacing=1.4,
    )

    fig.tight_layout()
    fig.subplots_adjust(bottom=0.25, top=0.94, hspace=0.7)

    plt.savefig(OUTPUT_PLOT, dpi=300, bbox_inches="tight")
    plt.show()

    print(f"Saved plot to: {OUTPUT_PLOT}")


if __name__ == "__main__":
    main()
