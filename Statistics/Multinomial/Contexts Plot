library(tidyr)
library(tidybayes)
library(dplyr)

ctx_all <- bind_rows(
  fit_opp_multi %>% 
    spread_draws(r_trinucleotide_context__muCtoG[trinucleotide_context, term]) %>% 
    mutate(class = "C>G", value = r_trinucleotide_context__muCtoG),

  fit_opp_multi %>% 
    spread_draws(r_trinucleotide_context__muCtoT[trinucleotide_context, term]) %>% 
    mutate(class = "C>T", value = r_trinucleotide_context__muCtoT),

  fit_opp_multi %>% 
    spread_draws(r_trinucleotide_context__muTtoA[trinucleotide_context, term]) %>% 
    mutate(class = "T>A", value = r_trinucleotide_context__muTtoA),

  fit_opp_multi %>% 
    spread_draws(r_trinucleotide_context__muTtoC[trinucleotide_context, term]) %>% 
    mutate(class = "T>C", value = r_trinucleotide_context__muTtoC),

  fit_opp_multi %>% 
    spread_draws(r_trinucleotide_context__muTtoG[trinucleotide_context, term]) %>% 
    mutate(class = "T>G", value = r_trinucleotide_context__muTtoG)
)

ctx_summary <- ctx_all %>%
  group_by(trinucleotide_context, class) %>%
  summarise(
    mean = mean(value),
    lower = quantile(value, 0.025, na.rm = TRUE),
    upper = quantile(value, 0.975, na.rm = TRUE),
    .groups = "drop"
  )

ctx_plot_df <- ctx_summary %>%
  mutate(
    odds_ratio = exp(mean),
    significant = lower > 0 | upper < 0
  )

row_order <- c(
  "A_A", "A_C", "A_G", "A_T",
  "C_A", "C_C", "C_G", "C_T",
  "G_A", "G_C", "G_G", "G_T",
  "T_A", "T_C", "T_G", "T_T"
)

col_order <- c("C>G", "C>T", "T>A", "T>C", "T>G")

ctx_mat <- ctx_plot_df %>%
  dplyr::select(trinucleotide_context, class, odds_ratio) %>%
  pivot_wider(names_from = class, values_from = odds_ratio) %>%
  as.data.frame()

rownames(ctx_mat) <- ctx_mat$trinucleotide_context
ctx_mat$trinucleotide_context <- NULL
ctx_mat <- as.matrix(ctx_mat)
ctx_mat <- ctx_mat[row_order, col_order]

ctx_sig_mat <- ctx_plot_df %>%
  dplyr::select(trinucleotide_context, class, significant) %>%
  pivot_wider(names_from = class, values_from = significant) %>%
  as.data.frame()

rownames(ctx_sig_mat) <- ctx_sig_mat$trinucleotide_context
ctx_sig_mat$trinucleotide_context <- NULL
ctx_sig_mat <- as.matrix(ctx_sig_mat)
ctx_sig_mat <- ctx_sig_mat[row_order, col_order]

# sanity check
ctx_mat["G_C", "T>C"]
ctx_sig_mat["G_C", "T>C"]

pdf("trinucleotide_multinomial_odds_ratio_heatmap_sig_FIXED.pdf", width = 7.5, height = 6.5)

par(mar = c(7, 7, 3, 2), xpd = NA)

cols <- colorRampPalette(
  c("#08306B", "#4292C6", "white", "#FB6A4A", "#A50F15")
)(200)

log_vals <- log2(ctx_mat)
zlim <- max(abs(log_vals), na.rm = TRUE)

n_rows <- nrow(ctx_mat)
n_cols <- ncol(ctx_mat)

plot(
  NA,
  xlim = c(0, n_cols),
  ylim = c(0, n_rows),
  xaxt = "n",
  yaxt = "n",
  xlab = "",
  ylab = "",
  bty = "n"
)

for(i in seq_len(n_rows)) {
  for(j in seq_len(n_cols)) {
    
    val <- log2(ctx_mat[i, j])
    col_id <- round((val + zlim) / (2 * zlim) * 199) + 1
    col_id <- max(1, min(200, col_id))
    
    rect(
      xleft = j - 1,
      ybottom = n_rows - i,
      xright = j,
      ytop = n_rows - i + 1,
      col = cols[col_id],
      border = "grey85"
    )
    
    if(ctx_sig_mat[i, j]) {
      points(
        x = j - 0.5,
        y = n_rows - i + 0.5,
        pch = 21,
        bg = "black",
        col = "white",
        cex = 1.1,
        lwd = 0.8
      )
    }
  }
}

axis(
  side = 2,
  at = seq(n_rows - 0.5, 0.5, by = -1),
  labels = rownames(ctx_mat),
  las = 1,
  tick = FALSE,
  cex.axis = 0.85
)

axis(
  side = 1,
  at = seq(0.5, n_cols - 0.5),
  labels = colnames(ctx_mat),
  las = 1,
  tick = FALSE,
  line = -0.5,
  cex.axis = 0.9
)

title("Trinucleotide context random effect")

text(
  x = n_cols / 2,
  y = -5,
  labels = "Black dot = 95% CI does not cross 0",
  cex = 0.8
)

legend(
  x = n_cols / 2,
  y = -2.4,
  legend = c("4× lower", "2× lower", "1×", "2× higher", "4× higher"),
  fill = cols[c(1, 45, 100, 155, 200)],
  title = "Odds ratio",
  horiz = TRUE,
  xjust = 0.5,
  bty = "n",
  cex = 0.85
)

dev.off()
