for ds in datasets:
    dataset_name = ds["dataset"]
    cds_models, cds_trees = load_cds_models(ds["gff"])
    codon_counts = {1: 0, 2: 0, 3: 0}

    for rec in iter_simple_vcf(ds["vcf"], pass_only=PASS_ONLY):
        seqid = normalize_seqid(rec["contig"])
        pos0 = rec["pos"] - 1
        overlapping = get_overlapping_transcripts(cds_trees, seqid, pos0)

        if not overlapping:
            continue

        if len(overlapping) > 1:
            if AMBIGUOUS == "skip":
                continue
            elif AMBIGUOUS == "first":
                overlapping = [sorted(overlapping)[0]]
            elif AMBIGUOUS == "all":
                overlapping = sorted(overlapping)

        for transcript_id in overlapping:
            model = cds_models[transcript_id]
            cds_offset0 = cds_offset_for_pos(model, pos0)
            if cds_offset0 is None:
                continue
            codon_pos = codon_position_from_offset(cds_offset0)
            codon_counts[codon_pos] += 1

    total = sum(codon_counts.values())
    for pos in [1, 2, 3]:
        summary_rows.append({
            "dataset": dataset_name,
            "genus": GENUS_MAP.get(dataset_name, "Unknown"),
            "label": SPECIES_LABELS.get(dataset_name, dataset_name),
            "codon_position": pos,
            "proportion": (codon_counts[pos] / total) if total > 0 else 0.0
        })

