def parse_gff_attributes(attr_string):
    attrs = {}
    for item in attr_string.strip().split(";"):
        if not item:
            continue
        if "=" in item:
            k, v = item.split("=", 1)
            attrs[k] = v
        elif " " in item:
            k, v = item.split(" ", 1)
            attrs[k] = v.strip('"')
    return attrs

def normalize_seqid(x):
    return str(x).strip()

def discover_datasets(snpeff_root):
    data_dir = os.path.join(snpeff_root, "data")
    ann_dir = os.path.join(snpeff_root, "annotated_vcfs")
    datasets = []

    for dataset in sorted(os.listdir(data_dir)):
        dataset_dir = os.path.join(data_dir, dataset)
        if not os.path.isdir(dataset_dir):
            continue

        gff_file = os.path.join(dataset_dir, "genes.gff")
        ann_vcf_file = os.path.join(ann_dir, dataset, f"{dataset}.ann.vcf")

        if os.path.exists(gff_file) and os.path.exists(ann_vcf_file):
            datasets.append({
                "dataset": dataset,
                "gff": gff_file,
                "vcf": ann_vcf_file,
            })
    return datasets

def load_cds_models(gff_file):
    cds_models = defaultdict(lambda: {"seqid": None, "strand": None, "parts": []})
    cds_trees = defaultdict(IntervalTree)

    with open(gff_file) as fh:
        for line in fh:
            if not line.strip() or line.startswith("#"):
                continue
            fields = line.rstrip("\n").split("\t")
            if len(fields) != 9:
                continue

            seqid, source, feature_type, start, end, score, strand, phase, attributes = fields
            if feature_type != "CDS":
                continue

            seqid = normalize_seqid(seqid)
            start0 = int(start) - 1
            end0 = int(end)
            attrs = parse_gff_attributes(attributes)

            transcript_id = (
                attrs.get("Parent")
                or attrs.get("ID")
                or attrs.get("transcript_id")
                or attrs.get("gene")
                or attrs.get("locus_tag")
                or f"{seqid}:{start0}-{end0}:{strand}"
            )

            cds_models[transcript_id]["seqid"] = seqid
            cds_models[transcript_id]["strand"] = strand
            cds_models[transcript_id]["parts"].append((start0, end0))
            cds_trees[seqid].addi(start0, end0, transcript_id)

    for transcript_id, model in cds_models.items():
        if model["strand"] == "+":
            model["parts"] = sorted(model["parts"], key=lambda x: x[0])
        else:
            model["parts"] = sorted(model["parts"], key=lambda x: x[0], reverse=True)

    return cds_models, cds_trees

def get_overlapping_transcripts(cds_trees, seqid, pos0):
    seqid = normalize_seqid(seqid)
    if seqid not in cds_trees:
        return []
    return [iv.data for iv in cds_trees[seqid].at(pos0)]

def cds_offset_for_pos(model, genomic_pos0):
    offset = 0
    strand = model["strand"]

    for start0, end0 in model["parts"]:
        seg_len = end0 - start0
        if start0 <= genomic_pos0 < end0:
            if strand == "+":
                return offset + (genomic_pos0 - start0)
            else:
                return offset + (end0 - 1 - genomic_pos0)
        offset += seg_len
    return None

def codon_position_from_offset(cds_offset0):
    return (cds_offset0 % 3) + 1

def iter_simple_vcf(vcf_path, pass_only=False):
    with open(vcf_path) as fh:
        for line in fh:
            if not line.strip() or line.startswith("#"):
                continue

            fields = line.rstrip("\n").split("\t")
            if len(fields) < 8:
                continue

            chrom, pos, vid, ref, alt, qual, filt, info = fields[:8]

            if "," in alt:
                continue
            if len(ref) != 1 or len(alt) != 1:
                continue
            if pass_only and filt not in ("PASS", "."):
                continue

            yield {
                "contig": chrom,
                "pos": int(pos),
                "ref": ref,
                "alt": alt,
            }

def make_genus_colors(ordered_datasets):
    genus_to_members = defaultdict(list)
    for ds in ordered_datasets:
        genus_to_members[GENUS_MAP.get(ds, "Other")].append(ds)

    color_map = {}
    for genus, members in genus_to_members.items():
        cmap_name = GENUS_COLORMAPS.get(genus, "viridis")
        cmap = cm.get_cmap(cmap_name)

        if len(members) == 1:
            values = [0.65]
        else:
            values = np.linspace(0.40, 0.85, len(members))

        for ds, v in zip(members, values):
            color_map[ds] = cmap(v)

    return color_map

