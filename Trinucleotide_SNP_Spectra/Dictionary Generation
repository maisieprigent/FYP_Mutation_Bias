import os
import collections


def load_fasta(fasta_file):
    sequences = {}
    current_name = None
    current_seq = []

    with open(fasta_file, "r") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue

            if line.startswith(">"):
                if current_name is not None:
                    sequences[current_name] = "".join(current_seq).upper()
                current_name = line[1:].split()[0]
                current_seq = []
            else:
                current_seq.append(line)

        if current_name is not None:
            sequences[current_name] = "".join(current_seq).upper()

    return sequences


def build_96_context_dictionary():
    bases = ["A", "C", "G", "T"]
    mutation_types = ["C>A", "C>G", "C>T", "T>A", "T>C", "T>G"]

    context_dict = collections.OrderedDict()
    for mut in mutation_types:
        for left in bases:
            for right in bases:
                key = f"{left}[{mut}]{right}"
                context_dict[key] = 0

    return context_dict

#counts opportunities once/ context
#e.g. ACG contributes 1 count to collapsed context and same denominator is used for all A(C>N)G

def count_reference_trinucleotide_contexts(fasta_file):

    sequences = load_fasta(fasta_file)
    complement = {"A": "T", "T": "A", "C": "G", "G": "C"}

    context_opportunities = collections.Counter()

    for seq in sequences.values():
        for i in range(1, len(seq) - 1):
            left = seq[i - 1]
            ref = seq[i]
            right = seq[i + 1]

            if left not in "ACGT" or ref not in "ACGT" or right not in "ACGT":
                continue

            # collapse to pyrimidine-centered context
            if ref in ["A", "G"]:
                left, right = complement[right], complement[left]
                ref = complement[ref]

            # now ref should be C or T
            context_key = f"{left}[{ref}]{right}"
            context_opportunities[context_key] += 1

    return context_opportunities


def generate_trinucleotide_context_counts(input_file, fasta_file):
    """
    Raw observed counts of 96-class trinucleotide contexts from VCF + FASTA.
    """

    ref_genome = load_fasta(fasta_file)
    complement = {"A": "T", "T": "A", "C": "G", "G": "C"}

    context_counts = build_96_context_dictionary()
    skipped = 0

    with open(input_file, "r") as vcf:
        for line in vcf:
            if line.startswith("#"):
                continue

            row = line.strip().split("\t")

            if row[6].strip() != "PASS":
                continue

            chrom = row[0]
            pos = int(row[1])
            ref = row[3].upper()
            alt = row[4].upper()

            if "," in alt:
                skipped += 1
                continue

            if len(ref) != 1 or len(alt) != 1 or ref == alt:
                skipped += 1
                continue

            if chrom not in ref_genome:
                skipped += 1
                continue

            seq = ref_genome[chrom]

            if pos < 2 or pos > len(seq) - 1:
                skipped += 1
                continue

            left = seq[pos - 2]
            middle = seq[pos - 1]
            right = seq[pos]

            if middle != ref:
                skipped += 1
                continue

            if left not in "ACGT" or right not in "ACGT":
                skipped += 1
                continue

            # collapse to pyrimidine representation
            if ref in ["A", "G"]:
                left, right = complement[right], complement[left]
                ref = complement[ref]
                alt = complement[alt]

            mutation = f"{ref}>{alt}"
            key = f"{left}[{mutation}]{right}"

            if key in context_counts:
                context_counts[key] += 1
            else:
                skipped += 1

    print(f"\nObserved trinucleotide counts for: {os.path.basename(input_file)}")
    print(f"Reference FASTA: {os.path.basename(fasta_file)}")
    print("Total contexts counted:", sum(context_counts.values()))
    print("Rows skipped:", skipped)

    return context_counts


def generate_opportunity_normalised_trinucleotide_spectrum(input_file, fasta_file, renormalise=True):
    """
    Counts observed 96-class contexts, divides by reference opportunities,
    and optionally renormalises so the spectrum sums to 1.
    """

    observed = generate_trinucleotide_context_counts(input_file, fasta_file)
    context_opportunities = count_reference_trinucleotide_contexts(fasta_file)

    normalised = collections.OrderedDict()

    for key in observed:
        # Convert e.g. A[C>T]G -> A[C]G for denominator lookup
        left = key[0]
        ref = key[2]
        right = key[6]
        context_key = f"{left}[{ref}]{right}"

        opp = context_opportunities.get(context_key, 0)

        if opp > 0:
            normalised[key] = observed[key] / opp
        else:
            normalised[key] = 0.0

    if renormalise:
        total = sum(normalised.values())
        if total > 0:
            normalised = collections.OrderedDict(
                (k, v / total) for k, v in normalised.items()
            )

    print(f"Total after normalisation: {sum(normalised.values()):.6f}")

    return normalised


def find_matching_fasta(vcf_filename, reference_folder):
    genome_name = vcf_filename.replace("_altered_foranalysis.vcf", "")
    fasta_path = os.path.join(reference_folder, f"{genome_name}.fna")

    if os.path.exists(fasta_path):
        return fasta_path

    return None

#returns dictionary of opportunity normalised spectra, can set renormalise to true if want to sum to 1


def generate_normalised_trinucleotide_spectra_for_folder(vcf_folder, reference_folder, renormalise=False):

    all_contexts = {}

    for filename in os.listdir(vcf_folder):
        if not filename.endswith(".vcf"):
            continue

        vcf_path = os.path.join(vcf_folder, filename)

        if not os.path.isfile(vcf_path):
            continue

        fasta_path = find_matching_fasta(filename, reference_folder)

        if fasta_path is None:
            print(f"\nNo matching FASTA found for: {filename}")
            continue

        spectrum = generate_opportunity_normalised_trinucleotide_spectrum(
            vcf_path,
            fasta_path,
            renormalise=renormalise
        )

        genome_name = filename.replace("_altered_foranalysis.vcf", "")
        all_contexts[genome_name] = spectrum

    return all_contexts


def generate_renormalised_trinucleotide_spectra_for_folder(vcf_folder, reference_folder):

    return generate_normalised_trinucleotide_spectra_for_folder(
        vcf_folder=vcf_folder,
        reference_folder=reference_folder,
        renormalise=True #change to true or false
    )

